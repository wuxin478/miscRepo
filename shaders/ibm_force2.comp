// IBM 核心：Peskin 的 4 点离散 Delta 权重函数 (基于论文定义)
float peskin_w(float r) {
    float abs_r = abs(r);
    
    if (abs_r <= 1.0) {
        // 1/8 * (3 - 2|r| + sqrt(1 + 4|r| - 4r^2))
        // 加上 max(0, ...) 是为了防止浮点误差导致 sqrt 内部出现极小负数
        return 0.125 * (3.0 - 2.0 * abs_r + sqrt(max(0.0, 1.0 + 4.0 * abs_r - 4.0 * abs_r * abs_r)));
    } 
    else if (abs_r <= 2.0) {
        // 1/8 * (5 - 2|r| - sqrt( -7 + 12|r| - 4r^2 ))
        return 0.125 * (5.0 - 2.0 * abs_r - sqrt(max(0.0, -7.0 + 12.0 * abs_r - 4.0 * abs_r * abs_r)));
    } 
    return 0.0; // r > 2.0 时截断为 0
}

// 辅助函数：计算 3D 空间下的权重乘积 w(|x-X|) * w(|y-Y|) * w(|z-Z|)
float compute_weight_3d(vec3 lagrangian_pos, vec3 eulerian_pos) {
    vec3 r = lagrangian_pos - eulerian_pos;
    return peskin_w(r.x) * peskin_w(r.y) * peskin_w(r.z);
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint k = gl_GlobalInvocationID.x;
    if (k >= ubo.lagrangianPointCount) return;

    vec3 point_pos = lagrangianPoints[k].position.xyz;

    bool is_last_iteration = (ubo.fixed_point_iteration == 4);

    vec3 force_to_spread;
    if (is_last_iteration) {
        force_to_spread = lagrangianData[k].force.xyz;
    } else {
        force_to_spread = tempForces[k].xyz;
    }

    // --- 2. 将力扩散到周围的 5x5x5 流体晶格 ---
    ivec3 center_cell = ivec3(round(point_pos));
    for (int i = -2; i <= 2; ++i) {
    for (int j = -2; j <= 2; ++j) {
    for (int k_cell = -2; k_cell <= 2; ++k_cell) {
        ivec3 cell_coord = center_cell + ivec3(i, j, k_cell);

        if (any(lessThan(cell_coord, ivec3(0))) || any(greaterThanEqual(cell_coord, ivec3(ubo.Nx, ubo.Ny, ubo.Nz)))) {
            continue;
        }

        uint fluid_index = cell_coord.z * ubo.Nx * ubo.Ny + cell_coord.y * ubo.Nx + cell_coord.x;
        vec3 fluid_pos = vec3(cell_coord);

        float weight = compute_weight_3d(point_pos, fluid_pos);
        if (weight == 0.0) continue;

        vec3 force_on_cell = force_to_spread * weight;

        // --- 3. 【核心】使用原子加来更新流场 ---
        if (is_last_iteration) {
            // 最后一次: G(X,Y,Z) = Σ Δu(k) * w(...) -> 写入 bfs
            atomicAdd(bfs[fluid_index],               force_on_cell.x);
            atomicAdd(bfs[ubo.Nxyz + fluid_index],    force_on_cell.y);
            atomicAdd(bfs[2 * ubo.Nxyz + fluid_index],force_on_cell.z);
        } else {
            // 中间迭代: U_iter+1 = U_iter + Σ g(k) * w(...) -> 直接更新 vels
            atomicAdd(vels[fluid_index],               force_on_cell.x);
            atomicAdd(vels[ubo.Nxyz + fluid_index],    force_on_cell.y);
            atomicAdd(vels[2 * ubo.Nxyz + fluid_index],force_on_cell.z);
        }
    }}}
}
