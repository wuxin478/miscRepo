#version 450
#extension GL_EXT_shader_atomic_float : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "simulate_header.glsl"

#define WORKGROUP_SIZE 256
layout (local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

shared vec3 s_force[WORKGROUP_SIZE];
shared vec3 s_torque[WORKGROUP_SIZE];
shared uint s_bodyIdx[WORKGROUP_SIZE];

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint global_id = gl_GlobalInvocationID.x;

    vec3 force_on_point = vec3(0.0);
    vec3 torque_on_point = vec3(0.0);
    uint bodyIdx = 0xFFFFFFFFu;

    if (global_id < ubo.lagrangianPointCount) {
        bodyIdx = bodyIndices[global_id];
        force_on_point = -lagrangianData[global_id].force.xyz;
        
        vec3 r_rest = lagrangianPoints_Rest[global_id].position.xyz;
        vec3 r_world = mat3(bodies[bodyIdx].modelMatrix) * r_rest; 
        torque_on_point = cross(r_world, force_on_point);
    }

    s_force[local_id] = force_on_point;
    s_torque[local_id] = torque_on_point;
    s_bodyIdx[local_id] = bodyIdx;

    barrier();

    for (uint s = WORKGROUP_SIZE / 2; s > 0; s >>= 1) {
        if (local_id < s) {
            if (s_bodyIdx[local_id] == s_bodyIdx[local_id + s]) {
                s_force[local_id] += s_force[local_id + s];
                s_torque[local_id] += s_torque[local_id + s];
            }
        }
        barrier();
    }

    if (local_id == 0 && s_bodyIdx[0] != 0xFFFFFFFFu && s_bodyIdx[0] < ubo.rigidBodyCount) {
        uint idx = s_bodyIdx[0];
        atomicAdd(total_force_torque[idx * 2].x, s_force[0].x);
        atomicAdd(total_force_torque[idx * 2].y, s_force[0].y);
        atomicAdd(total_force_torque[idx * 2].z, s_force[0].z);

        atomicAdd(total_force_torque[idx * 2 + 1].x, s_torque[0].x);
        atomicAdd(total_force_torque[idx * 2 + 1].y, s_torque[0].y);
        atomicAdd(total_force_torque[idx * 2 + 1].z, s_torque[0].z);
    }
}
